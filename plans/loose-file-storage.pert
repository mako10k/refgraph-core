project LOOSE_FILE_STORAGE:
  version 7
  title "Loose-file persistence and single-writer safety"
  description "Implement the accepted local persistence direction for refgraph-core: CID-visible loose block files, atomic operational roots, a process-level single writer, and a disposable in-memory reverse index rebuilt from canonical blocks. Resolve platform and stale-lock recovery contracts before implementation. Preserve CID identity, codec neutrality, canonical forward-link truth, fail-closed unknown-codec handling, explicit two-phase GC, and immutable-versus-derived corruption reporting. Multi-writer transactions, SQLite, index persistence, CID confidentiality, network storage, publication, and upper-layer semantics are non-goals."
  as_of 2026-08-18
  duration_unit point
  finish STORAGE_ACCEPTED
  goal_owner user
  dag_owner user

resource DEVELOPERS:
  title "Implementation capacity"
  description "One writer owns overlapping filesystem, adapter, and RefGraph changes."
  capacity 1

resource REVIEWERS:
  title "Architecture and acceptance review capacity"
  capacity 1

resource STORAGE_SURFACE:
  title "Filesystem persistence and locking ownership"
  capacity 1

resource GRAPH_SURFACE:
  title "RefGraph coordination and GC ownership"
  capacity 1

resource TEST_SURFACE:
  title "Fault injection and acceptance fixture ownership"
  capacity 1


milestone STORAGE_CONTRACT_ACCEPTED:
  title "Filesystem and recovery contract accepted"
  state reached

milestone PROCESS_LOCK_READY:
  title "Process-level writer lock ready"
  state reached

milestone BLOCK_STORE_READY:
  title "Loose-file block store ready"
  state reached

milestone ROOT_STORE_READY:
  title "Atomic file root store ready"

milestone REPOSITORY_INPUT_READY:
  title "Persistent repository composition inputs ready"

milestone REPOSITORY_READY:
  title "Persistent repository open and rebuild path ready"

milestone INTEGRITY_ACCEPTED:
  title "Filesystem corruption and crash behavior accepted"

milestone GC_ACCEPTED:
  title "Single-writer reachability and GC behavior accepted"

milestone DOCUMENTATION_READY:
  title "Persistence documentation and package surface ready"

milestone ACCEPTANCE_INPUT_READY:
  title "All persistence acceptance inputs ready"

milestone STORAGE_ACCEPTED:
  title "Loose-file persistence accepted"




task IMPLEMENT_ATOMIC_ROOT_STORE STORAGE_CONTRACT_ACCEPTED -> ROOT_STORE_READY:
  title "Implement atomic operational root persistence"
  description "Add AtomicFileRootStore behind RootStore. Persist only the versioned deterministic CID set, validate every CID and reject duplicate or malformed state, perform temporary write plus file fsync plus atomic rename plus directory fsync under the accepted platform contract, preserve the last valid document across injected failures, and fail closed on missing-versus-corrupt state according to the ADR. Never silently replace corruption with an empty root set."
  duration 4p
  status done
  priority 90
  requires:
    DEVELOPERS 1
    STORAGE_SURFACE 1
    TEST_SURFACE 1

gate LOCK_COMPOSITION_INPUT PROCESS_LOCK_READY -> REPOSITORY_INPUT_READY:
  reason "Repository mutation requires the accepted exclusive writer lock"

gate BLOCK_COMPOSITION_INPUT BLOCK_STORE_READY -> REPOSITORY_INPUT_READY:
  reason "Repository composition requires immutable loose block storage"

gate ROOT_COMPOSITION_INPUT ROOT_STORE_READY -> REPOSITORY_INPUT_READY:
  reason "Repository composition requires atomic operational roots"

task COMPOSE_PERSISTENT_REPOSITORY REPOSITORY_INPUT_READY -> REPOSITORY_READY:
  title "Compose persistent open, rebuild, and close lifecycle"
  description "Expose the smallest coherent local repository construction path without replacing neutral storage interfaces. Acquire the writer lock before mutation readiness, open block and root adapters, rebuild the in-memory reverse index from canonical blocks, reject write-ready open on immutable corruption or unsupported codec, preserve read-only verification evidence, and close resources in a deterministic order. Ensure RefGraph instance serialization and process lock ownership have one documented responsibility boundary."
  duration 4p
  priority 85
  requires:
    DEVELOPERS 1
    STORAGE_SURFACE 1
    GRAPH_SURFACE 1

task ACCEPT_FILESYSTEM_INTEGRITY REPOSITORY_READY -> INTEGRITY_ACCEPTED:
  title "Accept restart, corruption, and crash behavior"
  description "Add isolated-filesystem integration and fault-injection tests for restart identity, deterministic iteration and index rebuild, interrupted block and root writes, temporary residue, malformed CID paths, symlink and non-regular entries, permission errors, truncated and invalid root documents, immutable block corruption, orderly close, stale lock diagnostics, and explicit recovery boundaries. Prove fsck distinguishes immutable damage from repairable derived state and performs no silent rewrite."
  duration 5p
  priority 80
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    STORAGE_SURFACE 1
    TEST_SURFACE 1

task ACCEPT_SINGLE_WRITER_GC REPOSITORY_READY -> GC_ACCEPTED:
  title "Accept locked reachability and destructive GC"
  description "Exercise root mutation, canonical reachability, planGc, and commitGc through the persistent repository. Prove a second writer cannot change roots or blocks; commit recomputes under the held lock; stale plans are rejected; unknown codecs and immutable corruption expose no candidates; reachable blocks survive; partial deletion after an injected crash remains safe; restart rebuild removes derived index damage; and dry-run candidate inspection remains separate from deletion."
  duration 4p
  priority 80
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    STORAGE_SURFACE 1
    GRAPH_SURFACE 1
    TEST_SURFACE 1

task DOCUMENT_PERSISTENT_ADAPTER REPOSITORY_READY -> DOCUMENTATION_READY:
  title "Document and package the local persistence adapter"
  description "Update README, architecture, AGENTS guardrails, exports, and examples with repository layout, CID visibility, permissions, supported platforms, writer lifecycle, lock contention and stale recovery, root durability, index rebuild cost, GC crash guarantees, adapter error behavior, and non-goals. Add CI package smoke coverage using an isolated temporary repository without publishing or changing release state."
  duration 3p
  priority 70
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    STORAGE_SURFACE 1

gate INTEGRITY_FINAL_INPUT INTEGRITY_ACCEPTED -> ACCEPTANCE_INPUT_READY:
  reason "Final acceptance requires filesystem and crash-safety evidence"

gate GC_FINAL_INPUT GC_ACCEPTED -> ACCEPTANCE_INPUT_READY:
  reason "Final acceptance requires locked GC safety evidence"

gate DOCUMENTATION_FINAL_INPUT DOCUMENTATION_READY -> ACCEPTANCE_INPUT_READY:
  reason "Final acceptance requires the documented and packaged adapter boundary"

task ACCEPT_STORAGE_SLICE ACCEPTANCE_INPUT_READY -> STORAGE_ACCEPTED:
  title "Accept the loose-file single-writer storage slice"
  description "Run formatting, lint, strict typecheck, unit and integration tests, build, package dry-run, installed-tarball smoke, full fsck fixtures, deterministic index rebuild, and PERT validation. Review the implementation against the llmthink decisions and resolved pending items, confirm no upper-layer concepts or CID-obscuring identity entered core, record remaining limitations without weakening failed gates, and stop before commit, push, publication, release selection, or plan advance unless separately authorized."
  duration 3p
  priority 60
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    STORAGE_SURFACE 1
    GRAPH_SURFACE 1
    TEST_SURFACE 1

